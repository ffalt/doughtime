<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="dough_time_database"/>
        <include domain="database" path="dough_time_database-shm"/>
        <include domain="database" path="dough_time_database-wal"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="dough_time_database"/>
        <include domain="database" path="dough_time_database-shm"/>
        <include domain="database" path="dough_time_database-wal"/>
    </device-transfer>
</data-extraction-rules>